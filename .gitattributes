# Normalize line endings: LF in the repo, auto-convert on checkout
* text=auto

# Source files — always LF
*.py    text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Windows scripts — always CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf
