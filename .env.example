# Copy this file to .env in the project root, then fill in your real key(s).
# Never commit .env to Git — it is already in .gitignore.
#
# Only the key for the provider selected in config.yaml needs to be set.

# ── Anthropic ────────────────────────────────────────────────────────────────
# Required when config.yaml has `provider: anthropic`
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Groq ─────────────────────────────────────────────────────────────────────
# Required when config.yaml has `provider: groq`
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Required when config.yaml has `provider: openrouter`
# Get a key at: https://openrouter.ai/keys
# OpenRouter lets you use Claude, GPT-4o, Gemini, Llama, Mistral, and
# hundreds more through ONE key. Set model in config.yaml as:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-4o
#   google/gemini-2.5-pro
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (optional cloud storage) ────────────────────────────────────────
# Required when config.yaml has `enable_supabase: true`
# 1. Create a free project at https://supabase.com
# 2. Run supabase_schema.sql in the Supabase SQL editor (Database → SQL Editor)
# 3. Go to Project Settings → API Keys
# 4. Copy the "Project URL" from Settings → Data API
# 5. Copy the "Secret" (service_role) key — NOT the "Publishable" (anon) key.
#    The anon key is blocked by Row Level Security; the Secret key bypasses it.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-secret-service-role-key-here
